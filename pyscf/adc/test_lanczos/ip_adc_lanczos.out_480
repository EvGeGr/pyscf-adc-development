#INFO: **** input file is /home/evgeniy/prog/pyscf/pyscf/adc/test_lanczos/ip_adc_lanczos.py ****
import numpy as np

from pyscf import gto, scf, adc
from pyscf.adc import radc_ip


# ============================================================
# Symmetric Lanczos with full reorthogonalization
# ============================================================

def lanczos(matvec, v0, maxiter=100, tol=1.0e-12):
    """
    Standard symmetric Lanczos algorithm.

    Parameters
    ----------
    matvec : callable
        Function returning A @ x.
    v0 : ndarray
        Initial vector.
    maxiter : int
        Maximum Krylov dimension.
    tol : float
        Breakdown threshold.

    Returns
    -------
    alpha : ndarray
        Diagonal elements of the Lanczos matrix.
    beta : ndarray
        Off-diagonal elements of the Lanczos matrix.
    Q : ndarray
        Lanczos basis vectors as columns.
    """

    q = np.asarray(v0, dtype=float).copy()

    norm = np.linalg.norm(q)
    if norm < tol:
        raise ValueError("Initial Lanczos vector has zero norm.")

    q /= norm

    n = q.size

    Q = np.zeros((n, maxiter), dtype=float)
    alpha = np.zeros(maxiter, dtype=float)
    beta = np.zeros(maxiter - 1, dtype=float)

    q_prev = np.zeros_like(q)
    beta_prev = 0.0

    m = 0

    for j in range(maxiter):

        Q[:, j] = q

        # Matrix-vector product
        z = matvec(q)

        # alpha_j = q_j^T A q_j
        alpha[j] = np.dot(q, z)

        # Three-term Lanczos recurrence
        z -= alpha[j] * q

        if j > 0:
            z -= beta_prev * q_prev

        # ----------------------------------------------------
        # Full reorthogonalization
        # ----------------------------------------------------
        # This is intentionally used for the first implementation.
        # It makes the numerical comparison with Davidson cleaner.
        #
        # Two passes improve numerical orthogonality.
        # ----------------------------------------------------

        Qj = Q[:, :j+1]

        for _ in range(2):
            coeff = Qj.T @ z
            z -= Qj @ coeff

        b = np.linalg.norm(z)

        m = j + 1

        print(
            f"Iteration {j+1:4d}: "
            f"alpha = {alpha[j]:18.12f}   "
            f"beta = {b:12.5e}"
        )

        if b < tol:
            print("\nLanczos breakdown/convergence.")
            break

        if j == maxiter - 1:
            break

        beta[j] = b

        q_prev = q.copy()
        q = z / b
        beta_prev = b

    alpha = alpha[:m]

    if m > 1:
        beta = beta[:m-1]
    else:
        beta = np.empty(0)

    Q = Q[:, :m]

    return alpha, beta, Q


# ============================================================
# Construct tridiagonal Lanczos matrix
# ============================================================

def make_tridiagonal(alpha, beta):

    m = len(alpha)

    T = np.diag(alpha)

    if m > 1:
        idx = np.arange(m - 1)

        T[idx, idx + 1] = beta
        T[idx + 1, idx] = beta

    return T


# ============================================================
# Test system
# ============================================================

mol = gto.M(
    atom="""
    O   0.000000   0.000000   0.000000
    H   0.000000  -0.757000   0.587000
    H   0.000000   0.757000   0.587000
    """,
    basis="cc-pvdz",
    verbose=4,
)

mf = scf.RHF(mol)
mf.kernel()


# ============================================================
# ADC ground-state calculation
# ============================================================

myadc = adc.ADC(mf)

myadc.method = "adc(2)"
myadc.method_type = "ip"

myadc.kernel_gs()


# ============================================================
# Construct IP-ADC object
# ============================================================

myadcip = radc_ip.RADCIP(myadc)


# ============================================================
# Build integrals and IP-ADC matrix-vector function
#
# This follows exactly the beginning of radc.kernel():
#
#     eris = adc.transform_integrals()
#     imds = adc.get_imds(eris)
#     matvec, diag = adc.gen_matvec(imds, eris)
#
# ============================================================

eris = myadcip.transform_integrals()

imds = myadcip.get_imds(eris)

matvec, diag = myadcip.gen_matvec(imds, eris)


dim = len(diag)

print()
print("========================================")
print("IP-ADC matrix dimension =", dim)
print("========================================")
print()


# ============================================================
# Initial Lanczos vector
#
# For this numerical test use the basis vector corresponding
# to the smallest diagonal matrix element.
# ============================================================

i0 = np.argmin(diag)

v0 = np.zeros(dim)
v0[i0] = 1.0

print("Initial vector index:", i0)
print("Initial diagonal element:", diag[i0])


# ============================================================
# Lanczos
# ============================================================

maxiter = min(100, dim)

alpha, beta, Q = lanczos(
    matvec,
    v0,
    maxiter=dim,
    tol=1.0e-14,
)

T = make_tridiagonal(alpha, beta)

ritz_values, ritz_vectors = np.linalg.eigh(T)


print()
print("========================================")
print("Lowest Lanczos Ritz values")
print("========================================")

for i, e in enumerate(ritz_values[:10]):
    print(f"{i:3d}   {e:18.12f} Eh   {e * 27.211386245988:14.8f} eV")


# ============================================================
# Check orthogonality of Lanczos basis
# ============================================================

orth_error = np.linalg.norm(
    Q.T @ Q - np.eye(Q.shape[1])
)

print()
print("Lanczos basis orthogonality error:")
print(orth_error)


# ============================================================
# Davidson reference
#
# Use exactly the same IP-ADC object.
# ============================================================

print()
print("========================================")
print("PySCF Davidson reference")
print("========================================")

nroots = min(10, dim)

E_dav, U_dav, P_dav, X_dav = myadcip.kernel(
    nroots=nroots,
    eris=eris,
)


print()
print("========================================")
print("Davidson vs Lanczos")
print("========================================")

print(
    f"{'root':>5s} "
    f"{'Davidson / Eh':>20s} "
    f"{'Lanczos / Eh':>20s} "
    f"{'difference':>16s}"
)

for i in range(min(nroots, len(ritz_values))):

    diff = ritz_values[i] - E_dav[i]

    print(
        f"{i:5d} "
        f"{E_dav[i]:20.12f} "
        f"{ritz_values[i]:20.12f} "
        f"{diff:16.6e}"
    )
#INFO: ******************** input file end ********************


